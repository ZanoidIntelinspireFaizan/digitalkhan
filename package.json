{
  "name": "digitalkhan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Digital Khan — personal brand and software products website. Static HTML + Tailwind + vanilla JS.",
  "scripts": {
    "build:css": "tailwindcss -i src/styles/input.css -o assets/css/main.css --minify",
    "build:css:watch": "tailwindcss -i src/styles/input.css -o assets/css/main.css --watch",
    "build:images": "node scripts/generate-images.mjs && node scripts/copy-fonts.mjs",
    "build": "npm run build:css && npm run build:images && node scripts/build.mjs",
    "images": "node scripts/generate-images.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "serve": "python3 -m http.server 4173 --directory dist --bind 0.0.0.0",
    "preview": "npm run build && npm run serve"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "tailwindcss": "^3.4.17"
  }
}
